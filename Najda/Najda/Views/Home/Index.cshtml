@model HomeViewModel
@{
    ViewData["Title"] = "منصة التبرع بالدم";
}

<!-- ============ HERO ============ -->
<header class="hero">
    <div class="wrap hero-inner">
        <div class="hero-copy">
            <span class="eyebrow">ينقذ الأرواح في الوقت الحرج</span>
            <h1 class="hero-title">
                كل دقيقة تفرق.<br><span class="accent">قطرة دمك</span> قد تكون النجدة.
            </h1>
            <p class="hero-lead">
                نجدة تربط المستشفيات المحتاجة للدم بالمتبرعين المتوافقين والأقرب جغرافياً — خلال دقائق، لا ساعات. مجانية للمتبرعين دائماً.
            </p>
            <div class="hero-cta">
                <a asp-controller="Account" asp-action="Register" class="btn btn-donate btn-lg">
                    @Html.Icon("heart")
                    سجّل كمتبرع
                </a>
                <a asp-controller="Home" asp-action="About" class="btn btn-ghost btn-lg">كيف تعمل المنصة؟</a>
            </div>
            <div class="hero-trust">
                <p><strong>@Model.TotalDonors</strong> متبرع مسجّل جاهز للنجدة</p>
            </div>
        </div>

        <!-- Live urgent request preview (decorative) -->
        <div class="hero-visual">
            <div class="live-card card">
                <div class="live-head">
                    <span class="badge badge-urgent">عاجل الآن</span>
                    <span class="meta">مستشفى البشير · عمان</span>
                </div>
                <div class="live-body">
                    @Html.Droplet("O-", true, "lg")
                    <div>
                        <div class="live-need">مطلوب <strong>3</strong> وحدات</div>
                        <div class="live-sub">حالة طوارئ — قسم العناية المركّزة</div>
                    </div>
                </div>
                <div class="live-foot">
                    <div class="live-matched"><span class="dotpulse"></span>تمّت مطابقة متبرعَين قريبَين</div>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">استجب</a>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- ============ STATS BAR ============ -->
<section class="statbar">
    <div class="wrap statbar-grid">
        <div><div class="sb-num">@Model.AvailableDonors</div><div class="sb-lbl">متبرع متاح</div></div>
        <div><div class="sb-num crimson">@Model.UnitsProvided</div><div class="sb-lbl">وحدة دم تم توفيرها</div></div>
        <div><div class="sb-num">@Model.ApprovedHospitals</div><div class="sb-lbl">مستشفى شريك</div></div>
        <div><div class="sb-num gold">‹ 15 د</div><div class="sb-lbl">متوسط زمن المطابقة</div></div>
    </div>
</section>

<!-- ============ HOW IT WORKS ============ -->
<section class="section" id="how">
    <div class="wrap center">
        <span class="eyebrow">ثلاث خطوات</span>
        <h2 class="section-title">كيف تنقذ حياة عبر نجدة</h2>
        <p class="section-lead">عملية بسيطة صُمّمت لتكون سريعة وقت الطوارئ.</p>
    </div>
    <div class="wrap steps-grid">
        <div class="card card-hover step">
            <div class="step-n">1</div>
            <div class="step-ic">📝</div>
            <h3>سجّل فصيلتك وموقعك</h3>
            <p>أنشئ حساباً مجانياً وأدخل فصيلة دمك ومدينتك. تُوثّق فصيلتك تلقائياً بعد أول تبرّع فعلي.</p>
        </div>
        <div class="card card-hover step">
            <div class="step-n">2</div>
            <div class="step-ic">🔔</div>
            <h3>استقبل الطلبات المطابقة</h3>
            <p>عند وجود حالة عاجلة تناسب فصيلتك وقريبة منك، يصلك إشعار فوري. أنت تقرر متى تستجيب.</p>
        </div>
        <div class="card card-hover step">
            <div class="step-n">3</div>
            <div class="step-ic">❤️</div>
            <h3>تبرّع وأنقذ</h3>
            <p>توجّه للمستشفى وتبرّع. يسجّل النظام تبرّعك ويذكّرك بموعد أهليتك القادم بعد ٥٦ يوماً.</p>
        </div>
    </div>
</section>

<!-- ============ LIVE REQUESTS (from database) ============ -->
<section class="section section-alt">
    <div class="wrap">
        <div class="row-between" style="margin-block-end:26px">
            <div>
                <span class="eyebrow">مباشر</span>
                <h2 class="section-title" style="margin-block-end:0">طلبات تحتاج نجدتك الآن</h2>
            </div>
            <a asp-controller="Home" asp-action="UrgentRequests" class="btn btn-ghost">عرض الكل</a>
        </div>

        <div class="grid req-grid">
            @if (Model.LiveRequests.Any())
            {
                foreach (var r in Model.LiveRequests)
                {
                    <article class="card card-hover req-card">
                        <div class="req-top">
                            @Html.Droplet(r.BloodType, true, "sm")
                            <div class="req-head">
                                <div class="req-hosp">@r.Hospital?.Name</div>
                                <div class="meta">@Html.Icon("pin")<span>@r.Hospital?.City</span></div>
                            </div>
                            @Html.RequestBadge(r.Priority, r.Status)
                        </div>
                        <div class="req-need">
                            مطلوب <strong>@r.UnitsNeeded</strong> وحدات
                        </div>
                        <p class="req-note">@r.Department</p>
                        <div class="req-foot">
                            <span class="meta">@Html.Icon("users")<span>@r.Matches.Count مطابَق</span></span>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-soft btn-sm">استجب</a>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="empty card" style="grid-column:1/-1">
                    @Html.Icon("search")
                    <p>لا توجد طلبات عاجلة حالياً. تفقّد لاحقاً.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- ============ FOR HOSPITALS / BUSINESS ============ -->
<section class="section">
    <div class="wrap hosp-grid">
        <div class="hosp-copy">
            <span class="eyebrow">للمستشفيات وبنوك الدم</span>
            <h2 class="section-title">أداة إدارية توفّر عليك ساعات البحث</h2>
            <p class="section-lead">انشر طلباً عاجلاً فيصل تلقائياً للمتبرعين المتوافقين والأقرب. تابع حالة كل طلب، ووثّق فصيلة المتبرع بعد تبرّعه — كل ذلك من لوحة واحدة.</p>
            <ul class="ticks">
                <li>مطابقة تلقائية حسب الفصيلة والموقع</li>
                <li>تحليلات توفّر المتبرعين حسب كل فصيلة</li>
                <li>توثيق فصيلة المتبرع بعد التبرّع الفعلي</li>
            </ul>
            <div class="hosp-cta">
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">انضم كمستشفى</a>
                <span class="hosp-note">مجانية للمتبرعين وللمستشفيات</span>
            </div>
        </div>
        <div class="hosp-visual">
            <div class="mini-dash card">
                <div class="md-head">توفّر المتبرعين</div>
                <div class="md-bars">
                    @{
                        var avail = new (string bt, int pct)[] { ("O+", 82), ("A+", 64), ("B+", 47), ("O-", 23), ("AB-", 11) };
                    }
                    @foreach (var a in avail)
                    {
                        <div class="md-row">
                            @Html.BtChip(a.bt)
                            <div class="progress" style="flex:1"><i style="width:@(a.pct)%"></i></div>
                            <span class="md-pct">@(a.pct)%</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============ ETHICS NOTE ============ -->
<section class="section-sm">
    <div class="wrap ethic card">
        <div class="ethic-ic">🛡️</div>
        <div>
            <h3>مبدأنا: التبرّع لا يُباع</h3>
            <p>نجدة مشروع غير ربحي، ومجاني تماماً للمتبرعين وللمستشفيات بشكل دائم. لا تُباع بيانات المتبرعين، ولا يُستخدم التبرّع بالدم لأي غرض تجاري.</p>
        </div>
    </div>
</section>

<!-- ============ TESTIMONIALS ============ -->
<section class="section section-alt">
    <div class="wrap center">
        <span class="eyebrow">قصص</span>
        <h2 class="section-title">أشخاص صنعوا الفرق</h2>
    </div>
    <div class="wrap grid quote-grid">
        <figure class="card quote">
            <blockquote>"وصلني إشعار الساعة الثالثة فجراً، كانت الحالة قريبة من بيتي. أجمل شعور أن تكون النجدة."</blockquote>
            <figcaption><span class="avatar">ل</span><span>ليلى منصورمتبرعة · إربد</span></figcaption>
        </figure>
        <figure class="card quote">
            <blockquote>"كنا نتصل عشرات المكالمات لكل حالة. الآن الطلب يصل للمتبرع المناسب مباشرة. وفّر علينا وقتاً ثميناً."</blockquote>
            <figcaption><span class="avatar">ب</span><span>د. أحمد سرحانبنك الدم · مستشفى البشير</span></figcaption>
        </figure>
        <figure class="card quote">
            <blockquote>"تبرّعت أول مرة عبر نجدة، ووثّقوا فصيلتي في المستشفى. الآن أطمئن أن بياناتي صحيحة."</blockquote>
            <figcaption><span class="avatar">ع</span><span>عمر السالممتبرع · المفرق</span></figcaption>
        </figure>
    </div>
</section>

<!-- ============ FINAL CTA ============ -->
<section class="cta-band">
    <div class="wrap cta-inner">
        <h2>انضم إلى مجتمع نجدة. كن النجدة القادمة.</h2>
        <p>التسجيل يستغرق دقيقتين، والأثر يدوم مدى الحياة.</p>
        <div class="cta-actions">
            <a asp-controller="Account" asp-action="Register" class="btn btn-donate btn-lg">سجّل كمتبرع الآن</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-ghost btn-lg btn-ghost-light">انضم كمستشفى</a>
        </div>
    </div>
</section>
