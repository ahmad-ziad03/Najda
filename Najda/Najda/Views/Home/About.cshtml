@{
    ViewData["Title"] = "كيف تعمل نجدة";
}

<!-- intro -->
<header class="page-hero">
    <div class="wrap center">
        <span class="eyebrow">كيف تعمل المنصة</span>
        <h1 class="page-hero-title">من الطلب العاجل إلى النجدة، خطوة بخطوة</h1>
        <p class="page-hero-lead">نجدة تحوّل عملية البحث الفوضوية عن متبرع إلى نظام منظّم وسريع يربط المستشفى بالمتبرع المناسب خلال دقائق.</p>
    </div>
</header>

<!-- the problem -->
<section class="section">
    <div class="wrap prob-grid">
        <div class="prob-before card">
            <span class="badge badge-unverified">الطريقة التقليدية</span>
            <ul class="prob-list bad">
                <li>عشرات المكالمات العشوائية لكل حالة</li>
                <li>مجموعات تواصل غير منظّمة</li>
                <li>ساعات ثمينة تُهدر في الطوارئ</li>
                <li>لا تحقق من فصيلة المتبرع</li>
            </ul>
        </div>
        <div class="prob-arrow" aria-hidden="true">→</div>
        <div class="prob-after card">
            <span class="badge badge-fulfilled">مع نجدة</span>
            <ul class="prob-list good">
                <li>مطابقة تلقائية فورية</li>
                <li>وصول مباشر للمتبرع الأقرب والمتوافق</li>
                <li>متوسط مطابقة أقل من ٩ دقائق</li>
                <li>توثيق الفصيلة في المستشفى بعد التبرّع</li>
            </ul>
        </div>
    </div>
</section>

<!-- donor flow -->
<section class="section section-alt">
    <div class="wrap">
        <span class="eyebrow">للمتبرعين</span>
        <h2 class="section-title">رحلتك كمتبرع</h2>
        <div class="flow">
            @{
                var steps = new (string ic, string ar, string dAr)[]
                {
                    ("🩸", "أدخل فصيلتك", "أنشئ حساباً وأدخل فصيلة دمك ومدينتك ومنطقتك."),
                    ("📍", "حدّد موقعك", "موقعك يساعد النظام في إيجاد الحالات الأقرب إليك."),
                    ("🔔", "استقبل الطلبات", "يصلك إشعار عند وجود حالة عاجلة تناسب فصيلتك."),
                    ("✅", "تبرّع ووثّق", "تبرّع في المستشفى فتُوثّق فصيلتك ويُسجّل تبرّعك."),
                };
                var i = 0;
            }
            @foreach (var s in steps)
            {
                i++;
                <div class="flow-step">
                    <div class="flow-ic">@s.ic</div>
                    <div class="flow-n">@i</div>
                    <h3>@s.ar</h3>
                    <p>@s.dAr</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- verification explainer -->
<section class="section">
    <div class="wrap verify-grid">
        <div>
            <span class="eyebrow">الثقة أولاً</span>
            <h2 class="section-title">كيف نضمن صحة فصيلة الدم</h2>
            <p class="section-lead">قد لا يعرف المتبرع فصيلته بدقّة. لذلك تُعتبر الفصيلة المُدخلة "مبدئية" فقط لتضييق دائرة البحث، ويعيد المستشفى فحصها مخبرياً قبل أي نقل — وهذا هو البروتوكول الطبي المعتمد أصلاً.</p>
            <div class="verify-steps">
                <div class="vstep">
                    @Html.Droplet("O+", false)
                    <div>
                        <strong>عند التسجيل</strong>
                        <p>الفصيلة غير موثّقة — تُستخدم للفلترة المبدئية فقط.</p>
                    </div>
                </div>
                <div class="vstep">
                    @Html.Droplet("O+", true)
                    <div>
                        <strong>بعد أول تبرّع</strong>
                        <p>المستشفى تؤكّد الفصيلة أو تصحّحها، فتصبح موثّقة وترتفع أولويتك في المطابقة.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="compat card">
            <h3 class="compat-title">من يتبرّع لمن؟</h3>
            <p class="compat-sub">توافق خلايا الدم الحمراء</p>
            <div class="compat-table">
                @{
                    var compat = new (string bt, string from)[]
                    {
                        ("O-", "O-"),
                        ("O+", "O+, O-"),
                        ("A+", "A±, O±"),
                        ("B+", "B±, O±"),
                        ("AB+", "الكل / All"),
                    };
                }
                @foreach (var c in compat)
                {
                    <div class="compat-row">
                        @Html.BtChip(c.bt)
                        <span class="compat-arrow">←</span>
                        <span class="compat-from">@c.from</span>
                    </div>
                }
            </div>
            <p class="compat-note"><strong>O−</strong> متبرع عام · <strong>AB+</strong> مستقبِل عام</p>
        </div>
    </div>
</section>

<!-- sustainability model (non-profit) -->
<section class="section section-alt" id="pricing">
    <div class="wrap center">
        <span class="eyebrow">مشروع غير ربحي</span>
        <h2 class="section-title">مجانية لمن ينقذ الأرواح</h2>
        <p class="section-lead">نجدة مشروع غير ربحي بالكامل. المتبرعون والمستشفيات لا يدفعون أبداً، ولا تُستخدم بياناتهم لأي غرض تجاري.</p>
    </div>

    <div class="wrap free-banner card">
        <div class="fb-ic">🩸</div>
        <div class="fb-main">
            <strong>مجانية دائماً للمتبرعين وللمستشفيات</strong>
            <p class="muted">تسجيل، مطابقة تلقائية، تحليلات، وتوثيق الفصائل — دون أي رسوم على من ينقذون الأرواح.</p>
        </div>
        <span class="badge badge-fulfilled">0 رسوم</span>
    </div>

    <div class="wrap rev-grid">
        <div class="card rev">
            <div class="rev-n">1</div>
            <div class="rev-ic">🏛️</div>
            <h3>ترخيص المنصة لجهات رسمية</h3>
            <p class="rev-lead">يمكن ترخيص المنصة لوزارة الصحة والمستشفيات الخاصة لاستخدامها ضمن شبكتها، دون أي رسوم على المتبرعين.</p>
            <div class="rev-earn">
                <span class="rev-earn-lbl">كيف نستمر</span>
                اتفاقية ترخيص أو تشغيل مع وزارة الصحة أو مستشفيات خاصة.
            </div>
        </div>

        <div class="card rev">
            <div class="rev-n">2</div>
            <div class="rev-ic">🤲</div>
            <h3>منح وتبرعات داعمة</h3>
            <p class="rev-lead">منح من جهات صحية أو خيرية، وتبرعات داعمة لتشغيل المنصة وصيانتها — دون أي علاقة بعملية التبرّع بالدم نفسها.</p>
            <div class="rev-earn">
                <span class="rev-earn-lbl">كيف نستمر</span>
                منح مؤسسية وتبرعات تغطي الاستضافة والتطوير والصيانة.
            </div>
        </div>
    </div>

    <div class="wrap center" style="margin-block-start:28px">
        <a href="#" class="btn btn-primary btn-lg">تواصل معنا للشراكة</a>
    </div>
</section>

<!-- FAQ -->
<section class="section">
    <div class="wrap faq-wrap">
        <div class="center">
            <span class="eyebrow">أسئلة شائعة</span>
            <h2 class="section-title">أسئلة قد تدور في ذهنك</h2>
        </div>
        <div class="faq">
            @{
                var faqs = new (string qAr, string aAr)[]
                {
                    ("هل التبرّع عبر نجدة مجاني؟", "نعم، المنصة مجانية تماماً للمتبرعين بشكل دائم. لا نبيع الدم ولا نأخذ عمولة على التبرّع."),
                    ("ماذا لو لم أكن متأكداً من فصيلتي؟", "أدخل ما تعتقد أنه فصيلتك؛ ستبقى غير موثّقة وتُستخدم للفلترة فقط، ويؤكّدها المستشفى مخبرياً عند أول تبرّع."),
                    ("كم مرة أستطيع التبرّع؟", "يذكّرك النظام بموعد أهليتك القادم، وهو عادةً بعد ٥٦ يوماً من آخر تبرّع."),
                    ("كيف تستمر المنصة إن كانت مجانية؟", "نجدة مشروع غير ربحي. يمكن ترخيصها لوزارة الصحة أو مستشفيات خاصة، إلى جانب منح وتبرعات داعمة تغطي التشغيل — لا علاقة لذلك بعملية التبرّع نفسها."),
                };
            }
            @foreach (var f in faqs)
            {
                <details class="faq-item">
                    <summary>@f.qAr</summary>
                    <p>@f.aAr</p>
                </details>
            }
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="wrap cta-inner">
        <h2>جاهز تكون النجدة؟</h2>
        <p>سجّل اليوم وكن مستعداً حين يحتاجك أحدهم.</p>
        <div class="cta-actions">
            <a asp-controller="Account" asp-action="Register" class="btn btn-donate btn-lg">سجّل كمتبرع</a>
        </div>
    </div>
</section>
