@model RequestFormViewModel
@{
    ViewData["Title"] = "طلب دم جديد";
    Layout = "_LayoutDashboard";
    var types = new[] { "O+", "O-", "A+", "A-", "B+", "B-", "AB+", "AB-" };
}

<div class="page-head">
    <h2 class="page-head-title">أنشئ طلب دم جديد</h2>
    <p class="muted">سيصل الطلب تلقائياً للمتبرعين المتوافقين والأقرب إليك.</p>
</div>

<div class="post-grid">
    <section class="card">
        <form asp-action="PostRequest" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

            <div class="mb-3">
                <label asp-for="BloodType" class="form-label">فصيلة الدم المطلوبة</label>
                <select asp-for="BloodType" class="form-select" onchange="syncPreview()">
                    <option value="">اختر الفصيلة</option>
                    @foreach (var t in types)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
                <span asp-validation-for="BloodType" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UnitsNeeded" class="form-label">عدد الوحدات</label>
                <input asp-for="UnitsNeeded" class="form-control" type="number" min="1" max="50" dir="ltr" oninput="syncPreview()" />
                <span asp-validation-for="UnitsNeeded" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">مستوى الأولوية</label>
                <div class="prio">
                    <label>
                        <input type="radio" asp-for="Priority" value="Urgent" checked="@(Model.Priority != "Normal")" onchange="syncPreview()" />
                        <span class="prio-box prio-urgent"><strong>عاجل</strong><span>حالة طارئة الآن</span></span>
                    </label>
                    <label>
                        <input type="radio" asp-for="Priority" value="Normal" checked="@(Model.Priority == "Normal")" onchange="syncPreview()" />
                        <span class="prio-box prio-open"><strong>عادي</strong><span>خلال الأيام القادمة</span></span>
                    </label>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Department" class="form-label">القسم / سبب الطلب</label>
                <input asp-for="Department" class="form-control" placeholder="مثال: قسم العناية المركّزة" oninput="syncPreview()" id="deptInp" />
                <span asp-validation-for="Department" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NeededBy" class="form-label">الموعد النهائي (اختياري)</label>
                <input asp-for="NeededBy" class="form-control" type="date" dir="ltr" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-donate btn-lg">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 2s7 8 7 12.5A7 7 0 015 14.5C5 10 12 2 12 2z"/></svg>
                    نشر الطلب
                </button>
                <a asp-action="Dashboard" class="btn btn-ghost btn-lg">إلغاء</a>
            </div>
        </form>
    </section>

    <!-- live preview -->
    <aside class="preview-col">
        <div class="preview-label">معاينة كما سيراها المتبرع</div>
        <div class="card req-row" style="align-items:flex-start">
            <div id="prevToken"></div>
            <div class="rr-main">
                <div class="rr-top">
                    <strong>@ViewData["HospitalName"]</strong>
                    <span id="prevBadge"></span>
                </div>
                <p class="muted" style="font-size:.9rem;margin-block:2px 8px" id="prevNote">
                    قسم العناية المركّزة
                </p>
                <div class="rr-meta" id="prevMeta"></div>
            </div>
        </div>
        <div class="preview-hint">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01" stroke-linecap="round"/></svg>
            سيُرسل الإشعار فوراً لكل متبرع متوافق ومتاح ضمن نطاقك.
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function badge(prio) {
            var ar = prio === "Urgent" ? "عاجل" : "عادي";
            var cls = prio === "Urgent" ? "badge-urgent" : "badge-open";
            return '<span class="badge ' + cls + '">' + ar + '</span>';
        }
        function dropletMarkup(bt) {
            if (!bt) bt = "?";
            return '<div class="droplet is-verified droplet-sm"><span class="shape"></span><span class="type">' + bt + '</span></div>';
        }
        function syncPreview() {
            var bt = document.querySelector('[name="BloodType"]').value;
            var prio = document.querySelector('[name="Priority"]:checked').value;
            var units = document.querySelector('[name="UnitsNeeded"]').value || "0";
            var note = document.getElementById("deptInp").value;

            document.getElementById("prevToken").innerHTML = dropletMarkup(bt);
            document.getElementById("prevBadge").innerHTML = badge(prio);
            document.getElementById("prevNote").innerHTML = note
                ? '<span>' + note + '</span>'
                : 'قسم العناية المركّزة';
            document.getElementById("prevMeta").innerHTML =
                '<span class="meta">مطلوب ' + units + ' وحدات</span>';
        }
        document.addEventListener("DOMContentLoaded", syncPreview);
    </script>
}
