@using System.Security.Claims
@{
    // Controllers set:
    //   ViewData["Area"]   = "donor" | "hospital" | "admin"
    //   ViewData["Active"] = key of the active menu item
    var area = ViewData["Area"] as string ?? "donor";
    var active = ViewData["Active"] as string ?? "";
    string On(string key) => active == key ? "active" : "";

    // menu items: (key, controller, action, icon, label)
    var menus = new Dictionary<string, (string key, string ctrl, string act, string icon, string ar)[]>
    {
        ["donor"] = new[]
        {
            ("dash",     "Donor", "Dashboard", "home",    "لوحتي"),
            ("requests", "Donor", "Requests",  "list",    "الطلبات المطابقة"),
            ("history",  "Donor", "History",   "history", "سجل التبرعات"),
            ("profile",  "Donor", "Profile",   "user",    "ملفي الشخصي"),
        },
        ["hospital"] = new[]
        {
            ("dash",     "Hospital", "Dashboard",   "home",  "لوحة المستشفى"),
            ("post",     "Hospital", "PostRequest", "plus",  "طلب دم جديد"),
            ("requests", "Hospital", "Requests",    "list",  "إدارة الطلبات"),
            ("matched",  "Hospital", "Matched",     "users", "المتبرعون المطابقون"),
        },
        ["admin"] = new[]
        {
            ("dash",      "Admin", "Dashboard", "chart",    "نظرة عامة"),
            ("requests",  "Admin", "Requests",  "list",     "الطلبات"),
            ("users",     "Admin", "Donors",    "users",    "المتبرعون"),
            ("hospitals", "Admin", "Hospitals", "building", "المستشفيات"),
        },
    };
    var items = menus.TryGetValue(area, out var m) ? m : menus["donor"];

    var roleLabel = area switch
    {
        "hospital" => "حساب المستشفى",
        "admin"    => "لوحة الإدارة",
        _          => "حساب المتبرع",
    };

    var displayName = User.Identity?.Name ?? "—";
    var initial = string.IsNullOrEmpty(displayName) ? "N" : displayName.Substring(0, 1).ToUpper();
    var roleName = area switch { "hospital" => "مستشفى", "admin" => "مدير النظام", _ => "متبرع" };
}

<aside class="side" id="side">
    <a asp-controller="Home" asp-action="Index" class="brand">
        @Html.Icon("logo")
        <span>نجدة<small>@roleLabel</small></span>
    </a>

    <div class="side-label">القائمة</div>

    @foreach (var it in items)
    {
        <a asp-controller="@it.ctrl" asp-action="@it.act" class="@On(it.key)">
            @Html.Icon(it.icon)
            <span>@it.ar</span>
        </a>
    }

    <div class="spacer"></div>

    <div class="side-user">
        <div class="av">@initial</div>
        <div>
            <div class="nm">@displayName</div>
            <div class="rl">@roleName</div>
        </div>
    </div>

    <form asp-controller="Account" asp-action="Logout" asp-route-returnUrl="/" method="post">
        <button type="submit" class="side-logout">
            @Html.Icon("logout")
            <span>تسجيل الخروج</span>
        </button>
    </form>
</aside>
<div class="scrim" id="scrim" onclick="closeSide()"></div>
