@{
    var toast = TempData["Toast"] as string;
    var toastType = TempData["ToastType"] as string ?? "success";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Najda</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="~/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@@400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5 (RTL build) — loaded before styles.css so Najda's design takes precedence -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        <partial name="_Sidebar" />
        <div class="main">
            <partial name="_Topbar" />
            <div class="content">
                @RenderBody()
            </div>
        </div>
    </div>

    @if (toast is not null)
    {
        <div id="serverToast" data-msg="@toast" data-type="@toastType" hidden></div>
    }

    <!-- shared confirm dialog (replaces window.confirm) -->
    <div class="confirm-scrim" id="confirmScrim">
        <div class="confirm-box" role="alertdialog" aria-modal="true">
            <div class="confirm-ic" id="confirmIc">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
            </div>
            <h3 id="confirmTitle"></h3>
            <p id="confirmMsg"></p>
            <div class="confirm-actions">
                <button type="button" class="btn btn-ghost" id="confirmCancel">إلغاء</button>
                <button type="button" class="btn btn-donate" id="confirmOk">تأكيد</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
