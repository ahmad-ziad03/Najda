@{
    // Controllers set ViewData["ActiveNav"] to "home" | "about" | "requests".
    var active = ViewData["ActiveNav"] as string ?? "";
    string On(string key) => active == key ? "active" : "";
}
<nav class="nav">
    <div class="wrap nav-inner">
        <a asp-controller="Home" asp-action="Index" class="brand">
            @Html.Icon("logo")
            <span><span data-lang-ar>نجدة</span><span data-lang-en>Najda</span><small data-lang-ar>منصة التبرع بالدم</small><small data-lang-en>Blood Donation Platform</small></span>
        </a>

        <button class="nav-burger" aria-label="Menu" data-nav-burger>@Html.Icon("menu")</button>

        <div class="nav-links" id="navlinks">
            <a asp-controller="Home" asp-action="Index" class="@On("home")">
                <span data-lang-ar>الرئيسية</span><span data-lang-en>Home</span>
            </a>
            <a asp-controller="Home" asp-action="About" class="@On("about")">
                <span data-lang-ar>كيف تعمل</span><span data-lang-en>How it works</span>
            </a>
            <a asp-controller="Home" asp-action="Index" class="@On("requests")">
                <span data-lang-ar>الطلبات العاجلة</span><span data-lang-en>Urgent requests</span>
            </a>

            <div class="nav-actions">
                <button class="lang-toggle" type="button" onclick="toggleLang()">
                    @Html.Icon("globe")<span data-lang-label>EN</span>
                </button>
                <a asp-controller="Account" asp-action="Login" class="btn btn-ghost btn-sm">
                    <span data-lang-ar>تسجيل الدخول</span><span data-lang-en>Log in</span>
                </a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">
                    <span data-lang-ar>سجّل الآن</span><span data-lang-en>Sign up</span>
                </a>
            </div>
        </div>
    </div>
</nav>
