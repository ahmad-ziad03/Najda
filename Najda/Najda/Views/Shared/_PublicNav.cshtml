@{
    // Controllers set ViewData["ActiveNav"] to "home" | "about" | "requests".
    var active = ViewData["ActiveNav"] as string ?? "";
    string On(string key) => active == key ? "active" : "";
}
<nav class="nav">
    <div class="wrap nav-inner">
        <a asp-controller="Home" asp-action="Index" class="brand">
            @Html.Icon("logo")
            <span>نجدة<small>منصة التبرع بالدم</small></span>
        </a>

        <button class="nav-burger" aria-label="Menu" data-nav-burger>@Html.Icon("menu")</button>

        <div class="nav-links" id="navlinks">
            <a asp-controller="Home" asp-action="Index" class="@On("home")">
                الرئيسية
            </a>
            <a asp-controller="Home" asp-action="About" class="@On("about")">
                كيف تعمل
            </a>
            <a asp-controller="Home" asp-action="UrgentRequests" class="@On("requests")">
                الطلبات العاجلة
            </a>

            <div class="nav-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var ctrl = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Hospital") ? "Hospital" : "Donor";
                    <a asp-controller="@ctrl" asp-action="Dashboard" class="btn btn-ghost btn-sm">
                        لوحتي
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                        <button type="submit" class="btn btn-primary btn-sm">
                            خروج
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-ghost btn-sm">
                        تسجيل الدخول
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">
                        سجّل الآن
                    </a>
                }
            </div>
        </div>
    </div>
</nav>
