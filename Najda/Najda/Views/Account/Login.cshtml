@model LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = "_LayoutAuth";
}

<div class="auth">
    <div class="auth-box">
    <aside class="auth-aside">
        <a asp-controller="Home" asp-action="Index" class="brand">
            @Html.Icon("logo")<span>نجدة</span>
        </a>
        <div class="aside-body">
            <span class="auth-eyebrow">مرحباً بعودتك</span>
            <h2>أهلاً بعودتك!</h2>
            <p>سجّل دخولك لمتابعة الطلبات العاجلة القريبة منك وإدارة تبرعاتك.</p>
            <ul class="auth-features">
                <li><span class="fx">🔔</span>تابع الطلبات العاجلة</li>
                <li><span class="fx">🩸</span>أدر تبرعاتك بسهولة</li>
                <li><span class="fx">📍</span>مطابقة مع الأقرب إليك</li>
            </ul>
        </div>
        <svg class="deco" viewBox="0 0 24 24" fill="#fff"><path d="M12 2s7 8 7 12.5A7 7 0 015 14.5C5 10 12 2 12 2z"/></svg>
    </aside>

    <main class="auth-main">
        <div class="auth-card">
            <div class="top">
                <a asp-controller="Home" asp-action="Index" class="brand" style="color:var(--pine)">
                    @Html.Icon("logo")<span>نجدة</span>
                </a>
                            </div>

            <h1>تسجيل الدخول</h1>
            <p class="sub">أدخل بياناتك للمتابعة إلى حسابك.</p>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="mt-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small" role="alert" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-2">
                    <label asp-for="Password" class="form-label">كلمة المرور</label>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small">تذكّرني</label>
                    </div>
                    <a asp-action="ForgotPassword" style="color:var(--teal-dark);font-size:.86rem;font-weight:600">
                        نسيت كلمة المرور؟
                    </a>
                </div>

                <button class="btn btn-primary btn-block btn-lg" type="submit">دخول</button>
            </form>

            <p class="auth-alt">
                ليس لديك حساب؟
                <a asp-action="Register">سجّل الآن</a>
            </p>
        </div>
    </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
