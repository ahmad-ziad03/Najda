@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "استعادة كلمة المرور";
    Layout = "_LayoutAuth";
    var sent = ViewData["Sent"] as bool? == true;
}

<div class="auth">
    <div class="auth-box">
        <aside class="auth-aside">
            <a asp-controller="Home" asp-action="Index" class="brand">
                @Html.Icon("logo")<span><span data-lang-ar>نجدة</span><span data-lang-en>Najda</span></span>
            </a>
            <div class="aside-body">
                <span class="auth-eyebrow"><span data-lang-ar>استعادة الحساب</span><span data-lang-en>Account recovery</span></span>
                <h2><span data-lang-ar>لا تقلق، سنساعدك على العودة.</span><span data-lang-en>No worries — we'll get you back in.</span></h2>
                <p><span data-lang-ar>أدخل بريدك الإلكتروني وسنرسل لك رابطاً لإعادة تعيين كلمة المرور.</span><span data-lang-en>Enter your email and we'll send you a link to reset your password.</span></p>
                <ul class="auth-features">
                    <li><span class="fx">✉️</span><span data-lang-ar>أدخل بريدك المسجّل</span><span data-lang-en>Enter your registered email</span></li>
                    <li><span class="fx">🔑</span><span data-lang-ar>استلم رابط الاستعادة</span><span data-lang-en>Receive a reset link</span></li>
                </ul>
            </div>
            <svg class="deco" viewBox="0 0 24 24" fill="#fff"><path d="M12 2s7 8 7 12.5A7 7 0 015 14.5C5 10 12 2 12 2z" /></svg>
        </aside>

        <main class="auth-main">
            <div class="auth-card">
                <div class="top">
                    <a asp-controller="Home" asp-action="Index" class="brand" style="color:var(--pine)">
                        @Html.Icon("logo")<span><span data-lang-ar>نجدة</span><span data-lang-en>Najda</span></span>
                    </a>
                    <button class="lang-toggle" type="button" onclick="toggleLang()">
                        @Html.Icon("globe")<span data-lang-label>EN</span>
                    </button>
                </div>

                @if (sent)
                {
                    <div class="reset-sent">
                        <div class="reset-ic">@Html.Icon("check")</div>
                        <h1><span data-lang-ar>تحقّق من بريدك</span><span data-lang-en>Check your email</span></h1>
                        <p class="sub">
                            <span data-lang-ar>إن كان <strong>@Model.Email</strong> مسجّلاً لدينا، فسيصلك رابط لإعادة تعيين كلمة المرور خلال دقائق.</span>
                            <span data-lang-en>If <strong>@Model.Email</strong> is registered with us, a password-reset link is on its way within a few minutes.</span>
                        </p>
                        <a asp-action="Login" class="btn btn-primary btn-block btn-lg mt-3"><span data-lang-ar>العودة لتسجيل الدخول</span><span data-lang-en>Back to log in</span></a>
                    </div>
                }
                else
                {
                    <h1><span data-lang-ar>نسيت كلمة المرور؟</span><span data-lang-en>Forgot password?</span></h1>
                    <p class="sub"><span data-lang-ar>أدخل بريدك الإلكتروني لإرسال رابط الاستعادة.</span><span data-lang-en>Enter your email to receive a reset link.</span></p>

                    <form asp-action="ForgotPassword" method="post" class="mt-4">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"><span data-lang-ar>البريد الإلكتروني</span><span data-lang-en>Email</span></label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <button class="btn btn-primary btn-block btn-lg" type="submit"><span data-lang-ar>إرسال رابط الاستعادة</span><span data-lang-en>Send reset link</span></button>
                    </form>

                    <p class="auth-alt">
                        <span data-lang-ar>تذكّرت كلمة المرور؟</span><span data-lang-en>Remembered your password?</span>
                        <a asp-action="Login"><span data-lang-ar>تسجيل الدخول</span><span data-lang-en>Log in</span></a>
                    </p>
                }
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
