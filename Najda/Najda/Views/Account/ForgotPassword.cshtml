@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "استعادة كلمة المرور";
    Layout = "_LayoutAuth";
    var sent = ViewData["Sent"] as bool? == true;
}

<div class="auth">
    <div class="auth-box">
    <aside class="auth-aside">
        <a asp-controller="Home" asp-action="Index" class="brand">
            @Html.Icon("logo")<span>نجدة</span>
        </a>
        <div class="aside-body">
            <span class="auth-eyebrow">استعادة الحساب</span>
            <h2>لا تقلق، سنساعدك على العودة.</h2>
            <p>أدخل بريدك الإلكتروني وسنرسل لك رابطاً لإعادة تعيين كلمة المرور.</p>
            <ul class="auth-features">
                <li><span class="fx">✉️</span>أدخل بريدك المسجّل</li>
                <li><span class="fx">🔑</span>استلم رابط الاستعادة</li>
            </ul>
        </div>
        <svg class="deco" viewBox="0 0 24 24" fill="#fff"><path d="M12 2s7 8 7 12.5A7 7 0 015 14.5C5 10 12 2 12 2z"/></svg>
    </aside>

    <main class="auth-main">
        <div class="auth-card">
            <div class="top">
                <a asp-controller="Home" asp-action="Index" class="brand" style="color:var(--pine)">
                    @Html.Icon("logo")<span>نجدة</span>
                </a>
                            </div>

            @if (sent)
            {
                <div class="reset-sent">
                    <div class="reset-ic">@Html.Icon("check")</div>
                    <h1>تحقّق من بريدك</h1>
                    <p class="sub">
                        إن كان <strong>@Model.Email</strong> مسجّلاً لدينا، فسيصلك رابط لإعادة تعيين كلمة المرور خلال دقائق.
                    </p>
                    <a asp-action="Login" class="btn btn-primary btn-block btn-lg mt-3">العودة لتسجيل الدخول</a>
                </div>
            }
            else
            {
                <h1>نسيت كلمة المرور؟</h1>
                <p class="sub">أدخل بريدك الإلكتروني لإرسال رابط الاستعادة.</p>

                <form asp-action="ForgotPassword" method="post" class="mt-4">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-primary btn-block btn-lg" type="submit">إرسال رابط الاستعادة</button>
                </form>

                <p class="auth-alt">
                    تذكّرت كلمة المرور؟
                    <a asp-action="Login">تسجيل الدخول</a>
                </p>
            }
        </div>
    </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
