@model RegisterViewModel
@{
    ViewData["Title"] = "إنشاء حساب";
    Layout = "_LayoutAuth";
    var isHospital = Model.Role == "Hospital";
}

<div class="auth">
    <div class="auth-box">
    <aside class="auth-aside">
        <a asp-controller="Home" asp-action="Index" class="brand">
            @Html.Icon("logo")<span>نجدة</span>
        </a>
        <div class="aside-body">
            <span class="auth-eyebrow">ابدأ الآن</span>
            <h2>دقيقتان تفصلانك عن إنقاذ حياة.</h2>
            <p>انضم لمجتمع المتبرعين والمستشفيات الذين يجعلون الدم يصل في وقته.</p>
            <ul class="auth-features">
                <li><span class="fx">⏱️</span>تسجيل خلال دقيقتين</li>
                <li><span class="fx">✅</span>فصيلتك تُوثّق طبياً</li>
                <li><span class="fx">❤️</span>كن سبب إنقاذ حياة</li>
            </ul>
        </div>
        <svg class="deco" viewBox="0 0 24 24" fill="#fff"><path d="M12 2s7 8 7 12.5A7 7 0 015 14.5C5 10 12 2 12 2z"/></svg>
    </aside>

    <main class="auth-main">
        <div class="auth-card">
            <div class="top">
                <a asp-controller="Home" asp-action="Index" class="brand" style="color:var(--pine)">
                    @Html.Icon("logo")<span>نجدة</span>
                </a>
                            </div>

            <h1>إنشاء حساب</h1>
            <p class="sub">اختر نوع حسابك للبدء.</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small" role="alert" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                <!-- role toggle -->
                <div class="seg" style="margin-block:16px 20px">
                    <label>
                        <input type="radio" asp-for="Role" value="Donor" onchange="setRole('Donor')" checked="@(!isHospital)" />
                        <span class="seg-ic"><svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 2s7 8 7 12.5A7 7 0 015 14.5C5 10 12 2 12 2z"/></svg></span>
                        <span class="seg-body"><strong>متبرع</strong><span>أريد التبرع بالدم</span></span>
                    </label>
                    <label>
                        <input type="radio" asp-for="Role" value="Hospital" onchange="setRole('Hospital')" checked="@isHospital" />
                        <span class="seg-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21h16M6 21V5l6-2 6 2v16M10 9h.01M14 9h.01M12 13v4"/></svg></span>
                        <span class="seg-body"><strong>مستشفى</strong><span>نطلب الدم للمرضى</span></span>
                    </label>
                </div>

                <!-- name (label switches by role) -->
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label" id="nameLbl">
                        @(isHospital ? "اسم المستشفى" : "الاسم الكامل")
                    </label>
                    <input asp-for="FullName" class="form-control" placeholder="سامر الخطيب" id="nameInput" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- donor-only -->
                <div data-role-group="Donor" hidden="@isHospital">
                    <div>
                        <div class="mb-3">
                            <label asp-for="BloodType" class="form-label">فصيلة الدم</label>
                            <select asp-for="BloodType" class="form-select">
                                <option value="">اختر الفصيلة</option>
                                <option>O+</option><option>O-</option><option>A+</option><option>A-</option>
                                <option>B+</option><option>B-</option><option>AB+</option><option>AB-</option>
                            </select>
                            <div class="form-text">ستُوثّق في المستشفى عند أول تبرّع.</div>
                            <span asp-validation-for="BloodType" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label">رقم الهاتف</label>
                            <input asp-for="Phone" class="form-control" type="tel" placeholder="+962 7 ..." dir="ltr" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- hospital-only -->
                <div data-role-group="Hospital" hidden="@(!isHospital)">
                    <div>
                        <div class="mb-3">
                            <label asp-for="LicenseNumber" class="form-label">رقم الترخيص</label>
                            <input asp-for="LicenseNumber" class="form-control" placeholder="MOH-00000" dir="ltr" />
                            <div class="form-text">يُراجَع الحساب قبل الاعتماد.</div>
                            <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- location -->
                <div class="mb-3">
                    <label asp-for="City" class="form-label">المدينة</label>
                    <select asp-for="City" class="form-select">
                        <option value="">اختر المدينة</option>
                        @foreach (var c in Cities.All)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                    <span asp-validation-for="City" class="text-danger small"></span>
                </div>

                <!-- password -->
                <div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">كلمة المرور</label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <div class="form-text">٦ أحرف على الأقل مع رقم ورمز.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">تأكيد كلمة المرور</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <!-- consent -->
                <div class="form-check my-2">
                    <input asp-for="AgreeTerms" class="form-check-input" />
                    <label asp-for="AgreeTerms" class="form-check-label small">
                        أوافق على شروط الاستخدام وسياسة الخصوصية، وأن بياناتي تُستخدم لأغراض المطابقة فقط.
                    </label>
                    <div><span asp-validation-for="AgreeTerms" class="text-danger small"></span></div>
                </div>

                <button class="btn btn-primary btn-block btn-lg mt-2" type="submit">إنشاء الحساب</button>
            </form>

            <p class="auth-alt">
                لديك حساب بالفعل؟
                <a asp-action="Login">تسجيل الدخول</a>
            </p>
        </div>
    </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setRole(role) {
            document.querySelectorAll("[data-role-group]").forEach(g => {
                g.hidden = g.getAttribute("data-role-group") !== role;
            });
            var hospital = role === "Hospital";
            document.getElementById("nameLbl").textContent = hospital ? "اسم المستشفى" : "الاسم الكامل";
            var inp = document.getElementById("nameInput");
            inp.setAttribute("placeholder", hospital ? "مستشفى البشير" : "سامر الخطيب");
        }
    </script>
}
